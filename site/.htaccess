# Toolz — reglas de seguridad (2026-10-10)
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS lo manda PHP (auth.php) solo en conexiones HTTPS: "expr=" no anda igual en todos los servidores
    # CSP mínima (sin plugins, sin <base> ajeno, sin enmarcar desde otros sitios) SOLO para lo que no es PHP.
    # Ojo: en el hosting (LiteSpeed) "Header always set" pisa la CSP que manda PHP. Las páginas PHP mandan la suya:
    # la mínima desde auth.php y la estricta con g7_csp_enforce() y en login.php. (2026-11-13)
    <FilesMatch "\.(html?|svg|xml|txt|json|js|css)$">
        Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    </FilesMatch>
    Header always set Permissions-Policy "geolocation=(), payment=(), usb=()"
</IfModule>

# Límites de subida donde el hosting los lee de acá (LiteSpeed)
<IfModule lsapi_module>
    php_value upload_max_filesize 32M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>

# Archivos que nunca se sirven: configuración, respaldos, logs, notas, cachés con datos
<FilesMatch "(^\.|\.(sql|bak|old|orig|log|ini|env|md|sh|py|lock|dist|zip|gz|tgz|tar|7z|rar|pem|key|crt|p12|pfx|sqlite|db)$|^config\.local\.php$|^monday_cache\.json$)">
    Require all denied
</FilesMatch>
